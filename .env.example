# LLM provider config. Copy this file to .env and fill in to use a real LLM.
#
# If you set OPENAI_API_KEY, the app auto-selects the OpenAI provider — you do
# NOT need to set LLM_PROVIDER. Leave the key empty to run offline with the mock.

# LLM_PROVIDER=openai        # optional; auto-detected from OPENAI_API_KEY
OPENAI_API_KEY=              # your OpenAI/Azure API key (leave empty = offline mock)
OPENAI_BASE_URL=https://api.openai.com/v1   # or your Azure .../openai/v1 endpoint
OPENAI_MODEL=gpt-4o          # OpenAI model name, or your Azure deployment name

# Firewall behavior
FIREWALL_BLOCK_THRESHOLD=70  # risk score >= this => BLOCK
FIREWALL_SANITIZE_THRESHOLD=30  # risk score >= this (and < block) => SANITIZE

# LLM classifier layer (semantic second opinion; needs a real LLM key).
#   off  = rules only (fully offline)
#   gray = call the LLM only for inconclusive inputs (cheap, default w/ key)
#   all  = classify every non-blocked input (best coverage; more API calls)
FIREWALL_LLM_MODE=gray
